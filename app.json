{
  "expo": {
    "name": "graduation",
    "slug": "graduation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-green.png",
    "scheme": "graduation",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo-green.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.omarghorab.graduation",
      "googleServicesFile": "./google-services.json"
    },
    "notification": {
      "icon": "./assets/images/logo-green.png",
      "color": "#00A86B",
      "androidMode": "default",
      "androidCollapsedTitle": "{{unread_count}} new notifications"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-green.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-green.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo-green.png",
          "color": "#00A86B"
        }
      ],
      [
        "@react-native-google-signin/google-signin"
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "77bde963-870e-45da-8446-647c3d0c6160"
      }
    }
  }
}
